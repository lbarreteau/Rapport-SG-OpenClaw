# Copiez ce fichier en .env puis complétez-le (scripts/setup.sh le fait pour vous).

# --- Mode démo ---------------------------------------------------------------
# 1 = données fictives, aucune connexion bancaire. Pratique pour tester.
SG_REPORT_MOCK=0

# --- Enable Banking (accès Open Banking à la Société Générale) ----------------
# Identifiant (UUID) de l'application créée sur https://enablebanking.com/cp/applications
ENABLE_BANKING_APP_ID=
# Clé privée (.pem) téléchargée à la création de l'application, chemin relatif au dépôt ou absolu.
ENABLE_BANKING_PRIVATE_KEY=keys/enablebanking.pem
# URL de redirection déclarée dans l'application. La page n'a pas besoin d'exister :
# après validation, il suffit de copier l'adresse de la page (elle contient « code= »).
ENABLE_BANKING_REDIRECT_URL=https://localhost/sg-report/callback
# Nom de la banque chez Enable Banking (vérifiez avec : scripts/sg-report aspsps --search generale).
ENABLE_BANKING_ASPSP_NAME=Société Générale
ENABLE_BANKING_ASPSP_COUNTRY=FR
# personal = comptes particuliers, business = SG Professionnels.
ENABLE_BANKING_PSU_TYPE=personal
# Durée du consentement demandée, en jours (180 maximum, plafonnée par la banque).
ENABLE_BANKING_CONSENT_DAYS=180

# --- Rapport -------------------------------------------------------------------
SG_REPORT_TIMEZONE=Europe/Paris
# Alerte quand le solde d'un compte courant passe sous ce montant (euros).
SG_REPORT_LOW_BALANCE=200
# Règles de catégories personnalisées (voir categories.example.json).
# Vide = categories.json à la racine du dépôt s'il existe.
SG_REPORT_RULES_FILE=
# Dossier des données locales (session bancaire, opérations), créé en droits 0700.
SG_REPORT_DATA_DIR=data

# --- Livraison -----------------------------------------------------------------
# telegram : OpenClaw renvoie le rapport sur Telegram (rien d'autre à régler ici).
# ha       : le script envoie en plus une notification Home Assistant.
REPORT_CHANNEL=telegram
# Depuis l'add-on OpenClaw (réseau hôte), Home Assistant répond sur 127.0.0.1:8123.
HA_URL=http://127.0.0.1:8123
# Jeton d'accès longue durée Home Assistant. Vide = lecture de HA_TOKEN_FILE,
# par défaut /config/secrets/homeassistant.token (option homeassistant_token de l'add-on).
HA_TOKEN=
HA_TOKEN_FILE=
# Rapport complet en notification persistante (Markdown) dans Home Assistant.
HA_NOTIFY_SERVICE=persistent_notification.create
# Résumé court en push sur le téléphone (optionnel), ex. notify.mobile_app_mon_telephone
HA_PUSH_SERVICE=
